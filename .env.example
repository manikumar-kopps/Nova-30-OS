# Azure OpenAI Configuration
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/openai/v1
AZURE_OPENAI_API_KEY=your_azure_openai_api_key_here

TEXT_MODEL_DEPLOYMENT=gpt-4.1-mini
VISION_MODEL_DEPLOYMENT=gpt-4.1-mini
IMAGE_MODEL_DEPLOYMENT=FLUX-1.1-pro

CONTENT_ENDPOINT=https://your-resource.services.ai.azure.com/
CONTENT_API_KEY=your_content_api_key_here
CONTENT_API_VERSION=2025-11-01

FOUNDRY_PROJECT_ENDPOINT=https://your-resource.services.ai.azure.com/api/projects/your-project
FOUNDRY_API_KEY=your_foundry_api_key_here
FOUNDRY_AGENT_ID=your_agent_id_here

JWT_SECRET=your-super-secret-jwt-key-change-in-production
SECRET_KEY=your-flask-secret-key-change-in-production
ATTENDANCE_THRESHOLD=75

# Vite client-accessible mirrors
VITE_AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/openai/v1
VITE_AZURE_OPENAI_API_KEY=your_azure_openai_api_key_here
VITE_TEXT_MODEL_DEPLOYMENT=gpt-4.1-mini
VITE_VISION_MODEL_DEPLOYMENT=gpt-4.1-mini
VITE_IMAGE_MODEL_DEPLOYMENT=FLUX-1.1-pro
VITE_CONTENT_ENDPOINT=https://your-resource.services.ai.azure.com/
VITE_CONTENT_API_KEY=your_content_api_key_here
VITE_CONTENT_API_VERSION=2025-11-01
VITE_FOUNDRY_PROJECT_ENDPOINT=https://your-resource.services.ai.azure.com/api/projects/your-project
VITE_FOUNDRY_API_KEY=your_foundry_api_key_here
VITE_FOUNDRY_AGENT_ID=your_agent_id_here
